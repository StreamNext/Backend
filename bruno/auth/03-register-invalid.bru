meta {
  name: Register with a weak password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "weak-{{email}}",
    "password": "short",
    "deviceId": "{{deviceId}}"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq invalid_argument
}

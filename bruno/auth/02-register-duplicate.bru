meta {
  name: Register with a used email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "correct-horse-battery",
    "deviceId": "{{deviceId}}"
  }
}

assert {
  res.status: eq 409
  res.body.code: eq conflict
}

meta {
  name: Reusing the old refresh token is rejected
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{oldRefreshToken}}",
    "deviceId": "{{deviceId}}"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq unauthenticated
}

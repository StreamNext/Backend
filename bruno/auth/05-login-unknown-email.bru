meta {
  name: Login with an unknown email (same error)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "nobody-{{email}}",
    "password": "correct-horse-battery",
    "deviceId": "{{deviceId}}"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq unauthenticated
  res.body.message: eq invalid credentials
}

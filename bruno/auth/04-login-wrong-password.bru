meta {
  name: Login with a wrong password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "not-the-password",
    "deviceId": "{{deviceId}}"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq unauthenticated
  res.body.message: eq invalid credentials
}

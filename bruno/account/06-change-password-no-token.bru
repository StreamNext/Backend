meta {
  name: Change password without a token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/me/change-password
  body: json
  auth: none
}

body:json {
  {
    "currentPassword": "correct-horse-battery",
    "newPassword": "an-even-better-password",
    "deviceId": "{{deviceId}}"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq unauthenticated
}

meta {
  name: Change password with the wrong current password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/me/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "currentPassword": "not-my-password",
    "newPassword": "an-even-better-password",
    "deviceId": "{{deviceId}}"
  }
}

assert {
  res.status: eq 403
  res.body.code: eq forbidden
}

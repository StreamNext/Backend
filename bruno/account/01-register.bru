meta {
  name: Register a user for the account flow
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "correct-horse-battery",
    "deviceId": "{{deviceId}}"
  }
}

script:pre-request {
  bru.setVar("email", "account-" + Date.now() + "@example.com");
}

vars:post-response {
  accessToken: res.body.accessToken
  refreshToken: res.body.refreshToken
}

assert {
  res.status: eq 201
  res.body.user.emailVerified: eq false
}

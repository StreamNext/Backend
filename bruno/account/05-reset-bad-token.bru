meta {
  name: Reset with a bad token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "not-a-real-token",
    "newPassword": "an-even-better-password"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq invalid_argument
}

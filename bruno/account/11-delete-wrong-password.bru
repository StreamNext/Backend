meta {
  name: Delete account with the wrong password
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/v1/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "password": "not-my-password"
  }
}

assert {
  res.status: eq 403
  res.body.code: eq forbidden
}

meta {
  name: Change password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/me/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "currentPassword": "correct-horse-battery",
    "newPassword": "an-even-better-password",
    "deviceId": "{{deviceId}}"
  }
}

vars:post-response {
  accessToken: res.body.accessToken
  refreshToken: res.body.refreshToken
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
  res.body.user.email: eq {{email}}
}

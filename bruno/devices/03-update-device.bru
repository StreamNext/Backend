meta {
  name: Registering again updates the token
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/devices/{{deviceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "fcmToken": "fcm-token-two",
    "platform": "android"
  }
}

assert {
  res.status: eq 204
}

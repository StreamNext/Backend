meta {
  name: A search with no match is an empty list
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/search/series?query=zzzz%20no%20such%20show
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.results.length: eq 0
  res.body.hasMore: eq false
}
